+def normalise_number(token: str, currency: str) -> Decimal:
+    """Parse US (1,234.50) and European (1.234,50 / 45,90) number formats. The last separator is the
+    decimal point, except when it is repeated, the currency has no minor unit, or it is followed by
+    exactly three digits for a currency that does not have three minor digits (then it groups thousands)."""
+    digits = minor_digits(currency)
+    last = max(token.rfind("."), token.rfind(","))
+    if last == -1:
+        return Decimal(token)
+    frac = token[last + 1 :]
+    mixed = "." in token and "," in token
+    groups_thousands = (
+        token.count(token[last]) > 1 or digits == 0 or (not mixed and len(frac) == 3 and digits != 3)
+    )
+    if groups_thousands:
+        return Decimal(re.sub(r"[.,]", "", token))
+    return Decimal(re.sub(r"[.,]", "", token[:last]) + "." + frac)
 
 
