+type expensePatch struct {
+	Description *string                    `json:"description"`
+	Category    *contracts.ExpenseCategory `json:"category"`
+	Amount      *contracts.Money           `json:"amount"`
+	BaseAmount  *contracts.Money           `json:"base_amount"`
+	Date        *string                    `json:"date"`
+	HasReceipt  *bool                      `json:"has_receipt"`
+	Attendees   *int64                     `json:"attendees"`
+	Region      *contracts.Region          `json:"region"`
+}
+
+// revise corrects an expense. Submitted expenses are immutable, so the correction
+// is a new draft revision linked to the original; the original is never touched.
+func (s *Server) revise(w http.ResponseWriter, r *http.Request) {
+	a, err := actor(r)
+	if err != nil {
+		writeErr(w, err)
+		return
+	}
+	var p expensePatch
+	if err := json.NewDecoder(r.Body).Decode(&p); err != nil {
+		writeErr(w, bad("invalid JSON: %v", err))
+		return
+	}
+	orig, err := s.Store.Get(r.PathValue("id"))
+	if err != nil {
+		writeErr(w, err)
+		return
+	}
+	if a.ID != orig.EmployeeID {
+		writeErr(w, fmt.Errorf("only the owner may revise: %w", workflow.ErrForbidden))
+		return
+	}
+	rev, err := s.Store.Revise(orig.ID, func(rev *contracts.Expense) error {
+		if p.Description != nil {
+			rev.Description = *p.Description
+		}
+		if p.Category != nil {
+			rev.Category = *p.Category
+		}
+		if p.Amount != nil {
+			rev.Amount = *p.Amount
+		}
+		if p.BaseAmount != nil {
+			rev.BaseAmount = *p.BaseAmount
+		}
+		if p.Date != nil {
+			rev.Date = *p.Date
+		}
+		if p.HasReceipt != nil {
+			rev.HasReceipt = *p.HasReceipt
+		}
+		if p.Attendees != nil {
+			rev.Attendees = *p.Attendees
+		}
+		if p.Region != nil {
+			rev.Region = *p.Region
+		}
+		return validate(*rev)
+	})
+	if err != nil {
+		writeErr(w, err)
+		return
+	}
+	writeJSON(w, http.StatusCreated, rev)
+}
+
