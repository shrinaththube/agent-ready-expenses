+// Revise creates a new draft that corrects `origID` without touching the original.
+// The revision links to the root expense via RevisionOf and bumps Revision.
+func (m *Memory) Revise(origID string, apply func(*contracts.Expense) error) (contracts.Expense, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	orig, ok := m.byID[origID]
+	if !ok {
+		return contracts.Expense{}, fmt.Errorf("%s: %w", origID, ErrNotFound)
+	}
+	rev := orig
+	if err := apply(&rev); err != nil {
+		return contracts.Expense{}, err
+	}
+	root := orig.ID
+	if orig.RevisionOf != nil {
+		root = *orig.RevisionOf
+	}
+	m.seq++
+	rev.ID = fmt.Sprintf("exp-%04d", m.seq)
+	rev.Status = contracts.ExpenseStatusDraft
+	rev.Revision = orig.Revision + 1
+	rev.RevisionOf = &root
+	m.byID[rev.ID] = rev
+	return rev, nil
+}
