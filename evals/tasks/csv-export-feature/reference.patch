 // Format spec: docs/report-format.md (RFC 4180 quoting, CRLF, UTF-8 without BOM,
@@ -33,3 +33,15 @@ export function expensesCsv(expenses: Expense[]): string {
     ]),
   );
 }
+
+export const MONTHLY_HEADER = ["month", "employee_id", "category", "count", "total", "currency"];
+
+/** Monthly report export; format in docs/report-format.md. Rows sorted by month, employee, category. */
+export function monthlyReportCsv(rows: ReportRow[]): string {
+  const cmp = (a: string, b: string) => (a < b ? -1 : a > b ? 1 : 0);
+  const sorted = [...rows].sort((a, b) => cmp(a.month, b.month) || cmp(a.employee_id, b.employee_id) || cmp(a.category, b.category));
+  return toCsv(
+    MONTHLY_HEADER,
+    sorted.map((r) => [r.month, r.employee_id, r.category, String(r.count), formatAmount(r.total), r.total.currency]),
+  );
+}
